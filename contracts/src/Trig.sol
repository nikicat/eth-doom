pragma solidity ^0.8.20;

/// @notice Baked sin/cos table — WL_MAIN.C `BuildTables`. 450 entries of
/// signed-magnitude uint32 (magnitude low 16 bits, sign in bit 31, big-endian).
/// `cos[a] == sin[a + 90]`. Generated by `oracle/build/sim_oracle --dump-trig`;
/// do not hand-edit. Mirrors id's float truncation, so e.g. `cos[0] == 0xFFFF`.
library Trig {
    bytes internal constant SIN =
        hex"";

    /// @dev Copy the table to memory once per tick; pass the pointer to lookups.
    function table() internal pure returns (bytes memory t) {
        t = SIN;
    }

    /// @dev Raw signed-magnitude value of sin[idx], idx in [0, 449].
    function sinAt(bytes memory t, uint256 idx) internal pure returns (uint32 v) {
        assembly {
            v := shr(224, mload(add(add(t, 0x20), mul(idx, 4))))
        }
    }

    /// @dev cos[a] = sin[a + 90], a in [0, 359].
    function cosAt(bytes memory t, uint256 a) internal pure returns (uint32) {
        return sinAt(t, a + 90);
    }
}
